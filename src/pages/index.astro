---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Spider from '../components/Spider.astro';
import Web from '../components/Web.astro';
import Note from '../components/Note.astro';
import Thumb from '../components/Thumb.astro';
import hero from '../assets/stickers/hero.png';
import swing from '../assets/stickers/swing.png';
import portrait from '../assets/stickers/portrait.png';
import crouch from '../assets/stickers/crouch.png';
import hang from '../assets/stickers/hang.png';
import laptop from '../assets/stickers/laptop.png';
import wave from '../assets/stickers/wave.png';
import artAgent from '../assets/work/agent.png';
import artP2p from '../assets/work/p2p.png';
import artCrm from '../assets/work/crm.png';
import artSystems from '../assets/work/systems.png';
import artReels from '../assets/work/reels.png';
import artSite from '../assets/work/site.png';
const art = { agent: artAgent, p2p: artP2p, crm: artCrm, systems: artSystems, reels: artReels, site: artSite };

// ---------------------------------------------------------------------------
// Personal configuration for Sujal Kumar
// ---------------------------------------------------------------------------
const NAME = 'Sujal';
const FIRST_NAME = 'Sujal';
const SITE = 'sujal.dev';
const HANDLE = '@roxxsujal7';
const GH = 'https://github.com/RoxxSujal7';
const LINKEDIN = 'https://www.linkedin.com/in/sujalroxx7/';
const INSTAGRAM = 'https://www.instagram.com/roxxsujal7/';
const EMAIL = 'sujalsah9@gmail.com';

// Floating taped labels on the landing screen. x/y are % of the hero box.
const labels = [
  { text: 'Full-Stack Web', x: '5%', y: '26%', rot: -6 },
  { text: 'React & Next.js', x: '4%', y: '57%', rot: 4 },
  { text: 'AI Agents & LLMs', x: '77%', y: '27%', rot: 5 },
  { text: 'Python & FastAPI', x: '80%', y: '58%', rot: -4 },
  { text: 'Node.js & Systems', x: '8%', y: '80%', rot: -3 },
  { text: 'RAG & Vector DBs', x: '75%', y: '80%', rot: 6 },
];

const chips = [
  'TypeScript',
  'JavaScript',
  'Python',
  'React',
  'Next.js',
  'Node.js',
  'FastAPI',
  'LangChain',
  'LLM Agents',
  'PostgreSQL',
  'MongoDB',
  'Docker',
  'Git'
];

// Six cards tailored to Full Stack + AI Engineer profile.
const work: { kind: 'agent' | 'p2p' | 'crm' | 'reels' | 'systems' | 'site'; title: string; line: string; tag: string; href?: string }[] = [
  {
    kind: 'agent',
    title: 'Autonomous AI Assistant',
    line: 'Multi-agent orchestration system that reasons, executes workflows, and retrieves contextual knowledge.',
    tag: 'Python · LangChain · LLM APIs',
    href: GH
  },
  {
    kind: 'p2p',
    title: 'Real-Time Collaboration Platform',
    line: 'High-throughput full-stack web application with instant data synchronization and low-latency communication.',
    tag: 'Next.js · Node.js · WebSockets',
    href: GH
  },
  {
    kind: 'crm',
    title: 'AI Analytics & SaaS Dashboard',
    line: 'Full-stack business dashboard featuring automated reporting, telemetry, and modern data visualization.',
    tag: 'React · FastAPI · PostgreSQL',
    href: GH
  },
  {
    kind: 'systems',
    title: 'RAG & Semantic Search Engine',
    line: 'Document intelligence pipeline using embeddings and vector search to power grounded LLM responses.',
    tag: 'Python · Vector DB · FastAPI',
    href: GH
  },
  {
    kind: 'reels',
    title: 'Intelligent Automation Pipeline',
    line: 'Background job queues and data ingestion pipelines connecting cloud APIs with machine learning models.',
    tag: 'Node.js · Redis · Docker',
    href: GH
  },
  {
    kind: 'site',
    title: 'Interactive Portfolio',
    line: 'Dynamic poster-style portfolio built with Astro, GSAP micro-animations, and Lenis smooth scrolling.',
    tag: 'Astro · GSAP · TypeScript',
    href: GH
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{NAME} · {SITE}</title>
    <meta name="description" content={`Portfolio of ${NAME}, Full Stack & AI Engineer building modern web apps and intelligent systems.`} />
    <meta property="og:title" content={`${NAME} · Full Stack + AI Engineer`} />
    <meta property="og:description" content={`Explore projects, AI agents, and full-stack systems built by ${NAME}.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://${SITE}/`} />
    <meta name="theme-color" content="#1f1d3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,700&family=Nunito:wght@400;600;700;800&family=Kaushan+Script&family=Patrick+Hand&display=swap" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="wordmark" href="/">sujal<em>.</em>dev</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#work">Work</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href={GH} target="_blank" rel="noopener">GitHub</a></li>
            <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a></li>
          </ul>
        </nav>
        <button id="theme-toggle" aria-pressed="false" aria-label="Toggle Spidey theme" title="Toggle Spidey theme">
          <span style="position:relative;display:flex;align-items:center;justify-content:center;width:20px;height:20px;">
            <span class="icon-paper" style="font-size:16px;">☀️</span>
            <span class="icon-spidey" style="font-size:16px;">🕷️</span>
          </span>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span style="letter-spacing:0.01em">Spidey</span>
        </button>
      </div>
    </header>

    <main>
      <!-- ============ landing ============ -->
      <section class="hero" id="top">
        <Web class="web-hero-right" />
        <Web class="web-hero-left" />
        <div class="hero-word" aria-hidden="true"><span>{FIRST_NAME.toUpperCase()}</span></div>
        <svg class="thread" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
          <path d="M -30 430 C 110 390, 170 540, 290 480 S 430 370, 540 610 S 900 320, 1010 570 S 1210 430, 1310 510 S 1410 470, 1480 540" />
        </svg>

        <div class="swing-rig" aria-hidden="true">
          <span class="line"></span>
          <div class="sticker swing-img"><Image src={swing} alt="" widths={[500, 800]} sizes="40vh" format="webp" quality={80} loading="eager" /></div>
        </div>

        <div class="hero-stage">
          <div class="sticker hero-figure">
            <Image src={hero} alt="Illustrated character sitting on the ground, pointing to the side" widths={[700, 1000, 1500]} sizes="(max-width: 900px) 94vw, 820px" format="webp" quality={82} loading="eager" />
          </div>
          <p class="tagline"><span class="script">full stack &amp; AI</span> software engineer</p>
          <ul class="hero-cta">
            <li><a class="btn" href="#work">See the work</a></li>
            <li><a class="btn ghost" href="#contact">Say hi</a></li>
          </ul>
        </div>

        <ul class="labels">
          {labels.map((l) => <li style={`--x:${l.x}; --y:${l.y}`}><Note rot={l.rot}>{l.text}</Note></li>)}
        </ul>
        <Spider class="spider-hero" silk={70} />
      </section>

      <!-- ============ about ============ -->
      <div class="wrap" id="about">
        <div class="band" data-reveal><h2>About me</h2></div>
        <section class="about">
          <div class="sticker about-figure" data-pop>
            <Image src={portrait} alt="Portrait illustration of the character" widths={[500, 800, 1100]} sizes="(max-width: 900px) 78vw, 520px" format="webp" quality={82} />
          </div>
          <div class="about-text" data-reveal>
            <p class="hi">Hi, I'm</p>
            <h2 class="name">{NAME} <a class="script aka" href={GH} target="_blank" rel="noopener">aka {HANDLE}</a></h2>
            <p class="role">Full Stack &amp; AI Engineer · Web Systems · Intelligent Agents</p>
            <div class="prose">
              <p>I build modern full-stack web applications and intelligent AI systems. From designing scalable web architectures and responsive interfaces to implementing LLM-powered pipelines and retrieval systems, I focus on turning complex technical challenges into fast, reliable software.</p>
              <p>Driven by curiosity in generative AI, distributed systems, and real-time collaboration. Whether it's crafting high-performance APIs or building autonomous agents, I enjoy pushing the boundaries of what's possible on the web.</p>
            </div>
            <ul class="chips">{chips.map((c) => <li>{c}</li>)}</ul>
          </div>
          <Spider class="spider-about" silk={40} />
        </section>
      </div>

      <!-- ============ ready band ============ -->
      <div class="wrap ready">
        <div class="band ready-band" data-reveal>
          <p class="h">Get ready<br />to see <span class="script">the work</span></p>
          <div class="sticker ready-figure" data-pop>
            <Image src={crouch} alt="Illustrated character crouched on the edge of a ledge" widths={[500, 800]} sizes="(max-width: 900px) 40vw, 400px" format="webp" quality={82} />
          </div>
        </div>
      </div>

      <!-- ============ work ============ -->
      <section class="wrap work" id="work">
        <div class="watermark" aria-hidden="true">MY WORK</div>
        <header class="work-head" data-reveal>
          <div class="hang-rig" aria-hidden="true">
            <span class="line"></span>
            <div class="sticker"><Image src={hang} alt="" widths={[300, 500]} sizes="150px" format="webp" quality={80} /></div>
          </div>
          <h2>My work</h2>
          <span class="script sub">selected projects &amp; engineering builds</span>
        </header>
        <ul class="grid" data-stagger>
          {work.map((w) => (
            <li class="card">
              <a class="card-link" href={w.href ?? '#contact'} target={w.href ? '_blank' : undefined} rel={w.href ? 'noopener' : undefined}>
                <div class="thumb">
                  {art[w.kind]
                    ? <Image src={art[w.kind]} alt={`${w.title} illustration`} widths={[420, 640, 900]} sizes="(max-width: 900px) 92vw, 380px" format="webp" quality={80} />
                    : <Thumb kind={w.kind} />}
                </div>
                <div class="body">
                  <h3>{w.title}</h3>
                  <p>{w.line}</p>
                  <span class="tag">{w.tag}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="work-foot">
          <div class="band" data-reveal>
            <p class="h">Explore open source code &amp; experiments on <a class="script" href={GH} target="_blank" rel="noopener">{HANDLE}</a></p>
            <div class="sticker laptop-figure" data-pop>
              <Image src={laptop} alt="Illustrated character sitting on a ledge, typing on a laptop" widths={[500, 800]} sizes="(max-width: 900px) 40vw, 280px" format="webp" quality={82} />
            </div>
          </div>
        </div>
      </section>

      <!-- ============ contact ============ -->
      <div class="wrap" id="contact">
        <div class="band" data-reveal><h2>Say hi</h2></div>
        <section class="contact">
          <div class="watermark" aria-hidden="true">HELLO</div>
          <div class="sticker contact-figure" data-pop>
            <Image src={wave} alt="Illustrated character waving" widths={[500, 800]} sizes="(max-width: 900px) 70vw, 380px" format="webp" quality={82} />
          </div>
          <div class="contact-text" data-reveal>
            <h2>Let's build <span class="script">something</span></h2>
            <p class="lede">Have an exciting project, AI collaboration, or engineering role in mind? My inbox is always open.</p>
            <ul class="links">
              <li><Note rot={-4} href={`mailto:${EMAIL}`}>{EMAIL}</Note></li>
              <li class="socials-cluster">
                <div class="socials-row">
                  <Note rot={3} href={GH}>GitHub</Note>
                  <Note rot={-2} href={LINKEDIN}>LinkedIn</Note>
                </div>
                <div class="socials-center">
                  <Note rot={2} href={INSTAGRAM}>Instagram</Note>
                </div>
              </li>
            </ul>
          </div>
        </section>
      </div>
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>{SITE}</span>
        <span>© 2026 {NAME}</span>
        <span>built with code &amp; intelligence</span>
      </div>
    </footer>

    <script>import '../scripts/motion.ts';</script>
    <script>import '../scripts/theme.ts';</script>
  </body>
</html>
